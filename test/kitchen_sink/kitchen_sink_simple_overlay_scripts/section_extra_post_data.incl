SECTIONS
{
    PRE_OVERLAY : {
        PROVIDE(__overlays_start__ = .);
    } > RAM AT> RAM_STORE
    OVERLAY : {
        .overlay_first {
            KEEP (*(.first*))
            . = ALIGN(4);
        }
        .overlay_second {
            KEEP (*(.second*))
            . = ALIGN(4);
        }
    } > RAM AT> RAM_STORE
    POST_OVERLAY : {
        PROVIDE(__overlays_end__ = .);
    } > RAM AT> RAM_STORE
}
