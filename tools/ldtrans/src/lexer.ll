/* Use <<EOF>> rather than yywrap() to handle end-of-file */
%option noyywrap

/* We don't use unput() */
%option nounput

/* We don't use input() */
%option noinput

/* Don't implement a default rule for us */
%option nodefault

/* Declare lexer states */
%x COMMENT

/* Literal insertions into lexer.cpp (near top) */
%{

#include <iostream>

#include "Diagnostic.h"
#include "parser.hpp"
#include "SourceManager.h"
#include "lexer.h"
#include "main.h"

//#define TRACE(msg) std::cout << "Lexed " << msg << std::endl;
#define TRACE(msg)

/* Current location */
static SourceLocation current_location;
/* Location of most recently-lexed symbol */
SourceLocation lexer_symbol_location;

/* Include resumption stack */
static std::vector<SourceLocation> resume_locations;

#define ADVANCE() \
    do { \
        lexer_symbol_location = current_location; \
        current_location.offset += static_cast<std::size_t>(yyleng); \
    } while (0)

/* Since we've used %define api.token.constructor, we need to redefine YY_DECL
 * so that rather than returning an integer token type, yylex() returns an
 * object of type yy::parser::symbol_type, as generated by the various
 * make_* factory functions.
 */
#define YY_DECL yy::parser::symbol_type yylex()

static YY_BUFFER_STATE my_scan_buffer(FileId id);

%}

/* pattern/action pairs */
%%

"/*" {
    /* Start discarding comments */
    ADVANCE();
    BEGIN(COMMENT);
}

<COMMENT>"*/" {
    /* End of comment */
    ADVANCE();
    BEGIN(INITIAL);
}

<COMMENT>\n {
    ADVANCE();
    g_source_manager.addLine(current_location);
}

<COMMENT><<EOF>> {
    throw DiagnosticError(current_location, "Unterminated comment");
}

<COMMENT>. {
    /* Discard comment */
    ADVANCE();
}

[ \t\r]+ {
    /* Skip whitespace */
    ADVANCE();
}

ENTRY {
    TRACE("ENTRY")
    ADVANCE();
    return yy::parser::make_ENTRY(lexer_symbol_location);
}

