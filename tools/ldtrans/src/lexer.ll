[A-Za-z_.][A-Za-z0-9_.-]* {
    IdentifierToken tok{current_location, g_script.identifiers.toId(yytext)};
    ADVANCE();
    auto regularised = g_script.identifiers.toDisplayName(tok.id);
    TRACE("IDENTIFIER: " << yytext << " regularised to " << regularised)
    return yy::parser::make_IDENTIFIER(tok);
}

\"([^"\\\n]|\\.)*\" {
    std::size_t len = strlen(yytext);
    std::string unescaped;
    unescaped.reserve(len - 2);
    for (std::size_t i = 1; i < len - 1; ++i) {
        if (yytext[i] == '\\')
            ++i;
        unescaped.push_back(yytext[i]);
    }
    IdentifierToken tok{current_location, g_script.identifiers.toId(unescaped)};
    ADVANCE();
    auto regularised = g_script.identifiers.toDisplayName(tok.id);
    TRACE("IDENTIFIER: " << yytext << " regularised to " << regularised)
    return yy::parser::make_IDENTIFIER(tok);
}

0x[0-9A-Fa-f]+[KMkm]? {
    char* endptr;
    errno = 0;
    IntegerToken tok{current_location, strtoull(yytext, &endptr, 16)};
    if (tok.value == ULLONG_MAX && errno == ERANGE)
        throw DiagnosticError(current_location, "Integer overflow");
    if (endptr < yytext + yyleng)
        switch (*endptr) {
        case 'M':
        case 'm':
            if (tok.value > (UINT64_MAX >> 10))
                throw DiagnosticError(current_location, "Integer overflow");
            tok.value <<= 10;
            [[fallthrough]];
        case 'K':
        case 'k':
            if (tok.value > (UINT64_MAX >> 10))
                throw DiagnosticError(current_location, "Integer overflow");
            tok.value <<= 10;
        }
    ADVANCE();
    TRACE("INTEGER: " << yytext << " regularised to " << tok.value)
    return yy::parser::make_INTEGER(tok);
}

0[0-7]*[KMkm]? {
    char* endptr;
    errno = 0;
    IntegerToken tok{current_location, strtoull(yytext, &endptr, 8)};
    if (tok.value == ULLONG_MAX && errno == ERANGE)
        throw DiagnosticError(current_location, "Integer overflow");
    if (endptr < yytext + yyleng)
        switch (*endptr) {
        case 'M':
        case 'm':
            if (tok.value > (UINT64_MAX >> 10))
                throw DiagnosticError(current_location, "Integer overflow");
            tok.value <<= 10;
            [[fallthrough]];
        case 'K':
